<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_portfolio_crm_pipeline_graph" model="ir.ui.view">
        <field name="name">crm.lead.portfolio.pipeline.graph</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <graph string="Portfolio Pipeline" type="bar" sample="1">
                <field name="stage_id"/>
                <field name="weighted_revenue" type="measure"/>
                <field name="expected_revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_portfolio_crm_pipeline_pivot" model="ir.ui.view">
        <field name="name">crm.lead.portfolio.pipeline.pivot</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <pivot string="Portfolio Pipeline Analysis" sample="1">
                <field name="team_id" type="row"/>
                <field name="user_id" type="row"/>
                <field name="stage_id" type="col"/>
                <field name="weighted_revenue" type="measure"/>
                <field name="expected_revenue" type="measure"/>
                <field name="qualification_score" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_portfolio_crm_dashboard" model="ir.actions.act_window">
        <field name="name">Portfolio Dashboard</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="domain">[('type', '=', 'opportunity'), ('active', '=', True)]</field>
        <field name="context" eval="{'search_default_open_opportunities': 1, 'default_type': 'opportunity'}"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No opportunities yet — convert leads or create opportunities to populate the dashboard.
            </p>
        </field>
    </record>

    <record id="action_portfolio_crm_dashboard_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_portfolio_crm_pipeline_graph"/>
        <field name="act_window_id" ref="action_portfolio_crm_dashboard"/>
    </record>

    <record id="action_portfolio_crm_dashboard_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_portfolio_crm_pipeline_pivot"/>
        <field name="act_window_id" ref="action_portfolio_crm_dashboard"/>
    </record>
</odoo>
