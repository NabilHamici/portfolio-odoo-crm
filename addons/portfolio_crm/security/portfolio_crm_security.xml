<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_portfolio_crm">
        <field name="name">CRM Portfolio</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_crm_user" model="res.groups">
        <field name="name">CRM User</field>
        <field name="sequence">10</field>
        <field name="comment">Sales representatives: access assigned CRM records and create quotations from opportunities.</field>
        <field name="privilege_id" ref="res_groups_privilege_portfolio_crm"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_crm_manager" model="res.groups">
        <field name="name">CRM Manager</field>
        <field name="sequence">20</field>
        <field name="comment">CRM managers: access all CRM records, configuration, and portfolio dashboards.</field>
        <field name="privilege_id" ref="res_groups_privilege_portfolio_crm"/>
        <field name="implied_ids" eval="[(4, ref('group_crm_user')), (4, ref('sales_team.group_sale_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <!-- Sales reps: own + unassigned only -->
        <record id="rule_portfolio_crm_lead_user" model="ir.rule">
            <field name="name">Portfolio CRM: user sees own and unassigned leads</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_crm_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Managers: unrestricted -->
        <record id="rule_portfolio_crm_lead_manager" model="ir.rule">
            <field name="name">Portfolio CRM: manager sees all leads</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_crm_manager'))]"/>
        </record>
    </data>
</odoo>
